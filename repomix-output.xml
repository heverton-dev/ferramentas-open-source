<file path="scripts/hooks/pre-commit">
 1: #!/bin/sh
 2: # Hook pre-commit UNIVERSAL — mecaniza R15 (segredos) e R16 (nunca commitar vermelho).
 3: #
 4: # Fonte versionada: scripts/hooks/pre-commit
 5: # Copiado para .git/hooks/pre-commit por scripts/setup-links.ps1|.sh
 6: # (nao e link: .git/hooks nao aceita hardlink/junction de forma confiavel em todo SO).
 7: #
 8: # Principio: cada gate so roda se a ferramenta correspondente existir no projeto.
 9: # Em um projeto sem pytest, sem npm e sem code-review-graph, este hook e um no-op
10: # rapido — mas o gate de segredos SEMPRE roda.
11: 
12: # === GATE 1: SEGREDOS (R15) — sempre ativo ==================================
13: # Bloqueia o commit se o diff staged contiver padrao de credencial.
14: # POSIX sh nao tem array: a lista vai como argumentos do `for` (nao usar `while`
15: # num pipe — o subshell nao propaga o `exit 1` para o hook).
16: DIFF_STAGED=$(git diff --cached)
17: 
18: for padrao in \
19:     'sk-[a-zA-Z0-9_-]{20,}' \
20:     'AKIA[0-9A-Z]{16}' \
21:     '-----BEGIN [A-Z ]*PRIVATE KEY' \
22:     'gh[pousr]_[a-zA-Z0-9]{36}' \
23:     'github_pat_[a-zA-Z0-9_]{22,}' \
24:     'xox[baprs]-[0-9a-zA-Z-]+' \
25:     'AIza[0-9A-Za-z_-]{35}'
26: do
27:     # `--` e obrigatorio: o padrao de chave PEM comeca com '---' e sem ele o grep
28:     # o interpreta como opcao, sai com erro e o gate passa batido — inerte.
29:     if printf '%s' "$DIFF_STAGED" | grep -Eq -- "$padrao"; then
30:         echo "[BLOQUEADO] possivel segredo no diff staged"
31:         echo ""
32:         echo "Padrao detectado: $padrao"
33:         printf '%s' "$DIFF_STAGED" | grep -n -E -- "$padrao" | head -5
34:         echo ""
35:         echo "Se e falso positivo, revise manualmente ou use 'git commit --no-verify' (com cuidado)."
36:         exit 1
37:     fi
38: done
39: 
40: # === GATE 2: TESTES PYTHON (R16) — so se houver pytest e testes ==============
41: if [ -d tests ] || [ -f pytest.ini ] || [ -f pyproject.toml ]; then
42:     if command -v python >/dev/null 2>&1 && python -c "import pytest" >/dev/null 2>&1; then
43:         if ls tests/test_*.py test_*.py >/dev/null 2>&1; then
44:             python -m pytest -q
45:             if [ $? -ne 0 ]; then
46:                 echo "[BLOQUEADO] suite de testes vermelha - corrija a causa antes de comitar (R16)"
47:                 exit 1
48:             fi
49:         fi
50:     fi
51: fi
52: 
53: # === GATE 3: TESTES NODE (R16) — so se houver script "test" no package.json ==
54: if [ -f package.json ] && command -v npm >/dev/null 2>&1; then
55:     if grep -q '"test"[[:space:]]*:' package.json; then
56:         npm test --silent
57:         if [ $? -ne 0 ]; then
58:             echo "[BLOQUEADO] suite de testes vermelha - corrija a causa antes de comitar (R16)"
59:             exit 1
60:         fi
61:     fi
62: fi
63: 
64: # === GATE 4: SINTAXE PYTHON dos arquivos staged =============================
65: ARQS_PY=$(git diff --cached --name-only --diff-filter=ACM | grep '\.py$' || true)
66: if [ -n "$ARQS_PY" ] && command -v python >/dev/null 2>&1; then
67:     for f in $ARQS_PY; do
68:         [ -f "$f" ] || continue
69:         python -m py_compile "$f" || {
70:             echo "[BLOQUEADO] erro de sintaxe Python em: $f"
71:             exit 1
72:         }
73:     done
74: fi
75: 
76: # === GATE 5: GRAFO DE CODIGO (opcional) =====================================
77: # Regra 11 (CLAUDE.md): o painel do code-review-graph imprime unicode e quebra no
78: # console cp1252 (UnicodeEncodeError). Forca UTF-8 — nao depende do terminal.
79: if command -v code-review-graph >/dev/null 2>&1; then
80:     PYTHONIOENCODING=utf-8 PYTHONUTF8=1 code-review-graph update || true
81:     PYTHONIOENCODING=utf-8 PYTHONUTF8=1 code-review-graph detect-changes --brief || true
82: fi
83: 
84: exit 0
</file>

<file path="tests/test-junctions.sh">
 1: #!/usr/bin/env bash
 2: # Valida que os links de portabilidade multi-IDE existem E apontam para o alvo certo.
 3: #
 4: # Uso: bash tests/test-junctions.sh [raiz-do-projeto]
 5: #
 6: # Este teste so faz sentido DEPOIS de rodar scripts/setup-links.ps1|.sh.
 7: # Em CI (checkout limpo, sem setup-links) ele sai com 0 e um aviso — links de
 8: # portabilidade sao artefato de maquina local, nao conteudo versionado.
 9: set -uo pipefail
10: 
11: raiz="${1:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"
12: cd "$raiz"
13: 
14: falhas=0
15: ok()    { echo "[OK]  $1"; }
16: falha() { echo "[X]   $1"; falhas=$((falhas + 1)); }
17: 
18: # Um link de ARQUIVO pode ser symlink (Unix) ou hardlink (Windows). Hardlink nao
19: # e detectavel por `-L`: o criterio de verdade e o conteudo ser identico.
20: checar_arquivo() {
21:   local espelho="$1" fonte="$2"
22:   if [ ! -e "$espelho" ]; then
23:     falha "ausente: $espelho"
24:     return
25:   fi
26:   if [ ! -e "$fonte" ]; then
27:     falha "fonte ausente: $fonte"
28:     return
29:   fi
30:   if cmp -s "$espelho" "$fonte"; then
31:     ok "$espelho == $fonte"
32:   else
33:     falha "DESALINHADO (link quebrado por rewrite externo): $espelho != $fonte"
34:   fi
35: }
36: 
37: # Pasta: junction (Windows) ou symlink (Unix). Em ambos os casos o conteudo
38: # precisa ser visivel atraves do espelho.
39: #
40: # `find -L` e obrigatorio: sem ele, `find` NAO entra no link e reporta 0 itens.
41: # No Git Bash uma junction do Windows aparece como symlink, entao o caso Windows
42: # cai exatamente nessa armadilha — o teste acusaria "vazio" num link saudavel.
43: checar_pasta() {
44:   local espelho="$1" fonte="$2"
45:   if [ ! -d "$espelho" ]; then
46:     falha "ausente: $espelho/"
47:     return
48:   fi
49:   local n_espelho n_fonte
50:   n_espelho=$(find -L "$espelho" -maxdepth 1 -mindepth 1 2>/dev/null | wc -l)
51:   n_fonte=$(find -L "$fonte" -maxdepth 1 -mindepth 1 2>/dev/null | wc -l)
52:   if [ "$n_espelho" -eq "$n_fonte" ]; then
53:     ok "$espelho/ -> $fonte/ ($n_fonte item(ns))"
54:   else
55:     falha "DESALINHADO: $espelho/ tem $n_espelho item(ns), $fonte/ tem $n_fonte"
56:   fi
57: }
58: 
59: echo "[*] Validando links de portabilidade em: $raiz"
60: echo
61: 
62: if [ ! -e agentic/skills ] && [ ! -e AGENTS.md ]; then
63:   echo "[!]   Nenhum link encontrado — setup-links ainda nao foi rodado."
64:   echo "      Rode: scripts/setup-links.ps1 (Win) ou bash scripts/setup-links.sh"
65:   echo "      (esperado em checkout limpo de CI; nao e falha)"
66:   exit 0
67: fi
68: 
69: echo "== Arquivos de instrucao =="
70: checar_arquivo "AGENTS.md"                        ".claude/CLAUDE.md"
71: [ -e .clinerules ] && checar_arquivo ".clinerules" ".claude/CLAUDE.md"
72: [ -e .windsurfrules ] && checar_arquivo ".windsurfrules" ".claude/CLAUDE.md"
73: 
74: echo
75: echo "== Pastas neutras =="
76: checar_pasta "agentic/skills"   ".claude/skills"
77: checar_pasta "agentic/agents"   ".claude/agents"
78: checar_pasta "agentic/commands" ".claude/commands"
79: 
80: echo
81: echo "== .agents/ (apenas agents e commands — nunca skills/mcp-servers) =="
82: [ -e .agents/agents ]   && checar_pasta ".agents/agents"   ".claude/agents"
83: [ -e .agents/commands ] && checar_pasta ".agents/commands" ".claude/commands"
84: if [ -e .agents/skills ] || [ -e .agents/mcp-servers ]; then
85:   falha ".agents/ expoe skills/ ou mcp-servers/ — o Codebuff executa .js/.mjs daqui e o CLI morre"
86: fi
87: 
88: echo
89: if [ "$falhas" -gt 0 ]; then
90:   echo "REPROVADO — $falhas falha(s). Recrie com scripts/setup-links.ps1|.sh"
91:   exit 1
92: fi
93: echo "Links validados"
94: exit 0
