<file path="tests/test-integration.sh">
  1: #!/usr/bin/env bash
  2: # Valida a integracao da fabrica-universal em um projeto consumidor.
  3: #
  4: # Uso: bash tests/test-integration.sh [raiz-do-projeto]
  5: #      (padrao: raiz deste repositorio)
  6: #
  7: # Exit 0 = setup valido. Exit 1 = algo obrigatorio faltando.
  8: set -uo pipefail
  9: 
 10: raiz="${1:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"
 11: cd "$raiz"
 12: 
 13: falhas=0
 14: avisos=0
 15: 
 16: ok()    { echo "[OK]  $1"; }
 17: falha() { echo "[X]   $1"; falhas=$((falhas + 1)); }
 18: aviso() { echo "[!]   $1"; avisos=$((avisos + 1)); }
 19: 
 20: echo "[*] Validando setup em: $raiz"
 21: echo
 22: 
 23: # 1. CLAUDE.md com alwaysApply
 24: if [ -f .claude/CLAUDE.md ]; then
 25:   if grep -q "alwaysApply: true" .claude/CLAUDE.md; then
 26:     ok "CLAUDE.md com 'alwaysApply: true'"
 27:   else
 28:     falha "CLAUDE.md sem 'alwaysApply: true' no frontmatter"
 29:   fi
 30: else
 31:   falha ".claude/CLAUDE.md ausente"
 32: fi
 33: 
 34: # 2. Skills de economia (as 5 sao obrigatorias)
 35: for skill in caveman headroom lean-ctx rtk-memory pre-flight-check; do
 36:   if [ -f ".claude/skills/$skill/SKILL.md" ]; then
 37:     ok "skill: $skill"
 38:   else
 39:     falha "skill ausente: .claude/skills/$skill/SKILL.md"
 40:   fi
 41: done
 42: 
 43: # 3. Sintaxe Python de scripts/
 44: if command -v python >/dev/null 2>&1; then
 45:   if compgen -G "scripts/*.py" >/dev/null; then
 46:     if python -m py_compile scripts/*.py 2>/dev/null; then
 47:       ok "sintaxe Python (scripts/*.py)"
 48:     else
 49:       falha "erro de sintaxe em scripts/*.py"
 50:     fi
 51:   else
 52:     aviso "nenhum .py em scripts/"
 53:   fi
 54: else
 55:   aviso "python nao encontrado, pulando checagem de sintaxe"
 56: fi
 57: 
 58: # 4. Scripts universais presentes
 59: for s in setup-links.ps1 setup-links.sh validate.py; do
 60:   if [ -f "scripts/$s" ]; then
 61:     ok "script universal: $s"
 62:   else
 63:     falha "script universal ausente: scripts/$s"
 64:   fi
 65: done
 66: 
 67: # 5. Padroes reutilizaveis
 68: for p in skill-template.md script-template.py command-template.md mcp-template.js; do
 69:   if [ -f "scripts/padroes/$p" ]; then
 70:     ok "padrao: $p"
 71:   else
 72:     falha "padrao ausente: scripts/padroes/$p"
 73:   fi
 74: done
 75: 
 76: # 6. Hook pre-commit (fonte obrigatoria; instalado e aviso)
 77: if [ -f scripts/hooks/pre-commit ]; then
 78:   ok "hook pre-commit (fonte versionada)"
 79: else
 80:   falha "scripts/hooks/pre-commit ausente"
 81: fi
 82: if [ -f .git/hooks/pre-commit ]; then
 83:   ok "hook pre-commit (instalado)"
 84: else
 85:   aviso ".git/hooks/pre-commit ausente — rode scripts/setup-links.sh"
 86: fi
 87: 
 88: # 7. Junctions/symlinks de portabilidade (aviso: exigem setup-links rodado)
 89: if [ -e agentic/skills ]; then
 90:   ok "portabilidade: agentic/skills"
 91: else
 92:   aviso "agentic/skills ausente — rode scripts/setup-links.sh|.ps1"
 93: fi
 94: 
 95: echo
 96: if [ "$falhas" -gt 0 ]; then
 97:   echo "REPROVADO — $falhas falha(s), $avisos aviso(s)"
 98:   exit 1
 99: fi
100: echo "Setup validado — $avisos aviso(s)"
101: exit 0
</file>

<file path="tests/test-syntax.py">
  1: #!/usr/bin/env python3
  2: """
  3: test-syntax: compila todo .py do repositorio e valida todo .json/frontmatter.
  4: Entrada: raiz do repositorio (padrao: pai deste arquivo)
  5: Saida:   relatorio no console
  6: Garantias: read-only (nao altera nenhum arquivo), exit 0 = sucesso.
  7: 
  8: Uso:
  9:     python tests/test-syntax.py
 10:     python tests/test-syntax.py --raiz ../meu-projeto
 11: """
 12: 
 13: import argparse
 14: import json
 15: import py_compile
 16: import sys
 17: import tempfile
 18: from pathlib import Path
 19: 
 20: IGNORAR = {".git", "__pycache__", "node_modules", ".venv", "venv", ".pytest_cache"}
 21: 
 22: SKILLS_ECONOMIA = ["caveman", "headroom", "lean-ctx", "rtk-memory", "pre-flight-check"]
 23: 
 24: 
 25: def console_utf8():
 26:     for f in (sys.stdout, sys.stderr):
 27:         try:
 28:             f.reconfigure(encoding="utf-8", errors="replace")
 29:         except Exception:
 30:             pass
 31: 
 32: 
 33: def varrer(raiz, sufixo):
 34:     for p in raiz.rglob(f"*{sufixo}"):
 35:         if any(parte in IGNORAR for parte in p.parts):
 36:             continue
 37:         yield p
 38: 
 39: 
 40: def testar_python(raiz, erros):
 41:     arquivos = list(varrer(raiz, ".py"))
 42:     # cfile em tempdir: compilar nao deve sujar o repo com __pycache__ (read-only).
 43:     with tempfile.TemporaryDirectory() as tmp:
 44:         for i, p in enumerate(arquivos):
 45:             try:
 46:                 py_compile.compile(str(p), cfile=str(Path(tmp) / f"{i}.pyc"),
 47:                                    doraise=True)
 48:             except py_compile.PyCompileError as e:
 49:                 erros.append(f"Python: {p.relative_to(raiz)} — {e.msg.strip()}")
 50:     print(f"[*] Python: {len(arquivos)} arquivo(s) compilado(s)")
 51: 
 52: 
 53: def testar_json(raiz, erros):
 54:     arquivos = list(varrer(raiz, ".json"))
 55:     for p in arquivos:
 56:         try:
 57:             json.loads(p.read_text(encoding="utf-8"))
 58:         except json.JSONDecodeError as e:
 59:             erros.append(f"JSON: {p.relative_to(raiz)} — linha {e.lineno}: {e.msg}")
 60:     print(f"[*] JSON: {len(arquivos)} arquivo(s) parseado(s)")
 61: 
 62: 
 63: def testar_frontmatter_skills(raiz, erros):
 64:     """Todo SKILL.md precisa de frontmatter com name e description.
 65: 
 66:     Sem isso o harness nao indexa o skill — ele existe no disco e nunca e usado.
 67:     """
 68:     base = raiz / ".claude" / "skills"
 69:     if not base.is_dir():
 70:         erros.append("Skills: .claude/skills/ ausente")
 71:         return
 72:     encontrados = sorted(p.parent.name for p in base.glob("*/SKILL.md"))
 73:     for skill in base.glob("*/SKILL.md"):
 74:         texto = skill.read_text(encoding="utf-8", errors="replace")
 75:         if not texto.startswith("---"):
 76:             erros.append(f"Skill: {skill.parent.name} — sem frontmatter")
 77:             continue
 78:         cabecalho = texto.split("---", 2)[1]
 79:         for campo in ("name:", "description:"):
 80:             if campo not in cabecalho:
 81:                 erros.append(f"Skill: {skill.parent.name} — frontmatter sem '{campo}'")
 82:     faltando = [s for s in SKILLS_ECONOMIA if s not in encontrados]
 83:     if faltando:
 84:         erros.append("Skills de economia ausentes: " + ", ".join(faltando))
 85:     print(f"[*] Skills: {len(encontrados)} skill(s) verificado(s)")
 86: 
 87: 
 88: def testar_claude_md(raiz, erros):
 89:     alvo = raiz / ".claude" / "CLAUDE.md"
 90:     if not alvo.is_file():
 91:         erros.append("CLAUDE.md: .claude/CLAUDE.md ausente")
 92:         return
 93:     texto = alvo.read_text(encoding="utf-8", errors="replace")
 94:     if "alwaysApply: true" not in texto:
 95:         erros.append("CLAUDE.md: frontmatter sem 'alwaysApply: true'")
 96:     print("[*] CLAUDE.md: frontmatter verificado")
 97: 
 98: 
 99: def main():
100:     console_utf8()
101:     ap = argparse.ArgumentParser(description="Valida sintaxe do repositorio.")
102:     ap.add_argument("--raiz", default=str(Path(__file__).resolve().parent.parent))
103:     args = ap.parse_args()
104: 
105:     raiz = Path(args.raiz).resolve()
106:     print(f"Repositorio: {raiz}\n")
107: 
108:     erros = []
109:     testar_python(raiz, erros)
110:     testar_json(raiz, erros)
111:     testar_claude_md(raiz, erros)
112:     testar_frontmatter_skills(raiz, erros)
113: 
114:     print()
115:     if erros:
116:         for e in erros:
117:             print(f"[X] {e}")
118:         print(f"\nREPROVADO — {len(erros)} erro(s)")
119:         return 1
120:     print("Sintaxe validada")
121:     return 0
122: 
123: 
124: if __name__ == "__main__":
125:     sys.exit(main())
</file>

