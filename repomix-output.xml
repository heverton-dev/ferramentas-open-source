  1: #!/usr/bin/env python3
  2: """token_savings_estimator.py — Estimate token-cost savings from caveman compression.
  3: 
  4: Stdlib-only. Uses a chars-per-token heuristic (4 chars/token average for English
  5: prose; 3.5 for technical text) to estimate output tokens before vs after caveman
  6: compression.
  7: 
  8: Why heuristic and not real tokenizer:
  9: - No external dependencies (stdlib only)
 10: - Tokenizer accuracy varies by model (cl100k_base vs o200k_base vs others)
 11: - Heuristic is within 10-15% of real tokenizer output for English prose
 12: - Reports both heuristic + character count so user can apply their own multiplier
 13: 
 14: Usage:
 15:     python token_savings_estimator.py                         # uses embedded sample
 16:     python token_savings_estimator.py "your text"
 17:     python token_savings_estimator.py --file path/to/input.txt
 18:     python token_savings_estimator.py "text" --output json
 19:     python token_savings_estimator.py "text" --price-per-mtok 3.00
 20: """
 21: 
 22: import argparse
 23: import json
 24: import sys
 25: from typing import Any, Dict
 26: 
 27: # Import the compressor as a module
 28: import os
 29: _HERE = os.path.dirname(os.path.abspath(__file__))
 30: sys.path.insert(0, _HERE)
 31: from caveman_compressor import compress, SAMPLE_INPUT  # noqa: E402
 32: 
 33: 
 34: # Heuristic: average chars per token
 35: CHARS_PER_TOKEN_PROSE = 4.0
 36: CHARS_PER_TOKEN_TECHNICAL = 3.5
 37: TECHNICAL_TOKEN_INDICATORS = ("```", "{", "}", "()", "->", "==", "//", "/*", "import ", "function ")
 38: 
 39: 
 40: def _estimate_chars_per_token(text: str) -> float:
 41:     """Heuristic: technical text has more tokens per char than prose."""
 42:     hit_count = sum(1 for sig in TECHNICAL_TOKEN_INDICATORS if sig in text)
 43:     if hit_count >= 3:
 44:         return CHARS_PER_TOKEN_TECHNICAL
 45:     return CHARS_PER_TOKEN_PROSE
 46: 
 47: 
 48: def estimate_tokens(text: str) -> int:
 49:     return int(round(len(text) / _estimate_chars_per_token(text)))
 50: 
 51: 
 52: def analyze(original: str, price_per_mtok: float = 0.0) -> Dict[str, Any]:
 53:     compressed = compress(original)
 54:     orig_tokens = estimate_tokens(original)
 55:     new_tokens = estimate_tokens(compressed)
 56:     saved = orig_tokens - new_tokens
 57:     pct = round(100.0 * saved / max(orig_tokens, 1), 1)
 58: 
 59:     out: Dict[str, Any] = {
 60:         "original_chars": len(original),
 61:         "compressed_chars": len(compressed),
 62:         "chars_per_token_used": _estimate_chars_per_token(original),
 63:         "estimated_original_tokens": orig_tokens,
 64:         "estimated_compressed_tokens": new_tokens,
 65:         "tokens_saved": saved,
 66:         "percent_token_savings": pct,
 67:         "compressed_preview": compressed[:200] + ("..." if len(compressed) > 200 else ""),
 68:     }
 69: 
 70:     if price_per_mtok > 0:
 71:         cost_per_token = price_per_mtok / 1_000_000.0
 72:         out["price_per_million_tokens"] = price_per_mtok
 73:         out["cost_saved_per_response_usd"] = round(saved * cost_per_token, 6)
 74:         out["cost_saved_per_1k_responses_usd"] = round(saved * cost_per_token * 1000, 4)
 75: 
 76:     return out
 77: 
 78: 
 79: def render_text(r: Dict[str, Any]) -> str:
 80:     lines = []
 81:     lines.append("=" * 72)
 82:     lines.append("TOKEN SAVINGS ESTIMATOR (caveman compression)")
 83:     lines.append("=" * 72)
 84:     lines.append("")
 85:     lines.append(f"Chars/token heuristic: {r['chars_per_token_used']:.1f} (prose=4.0; technical=3.5)")
 86:     lines.append("")
 87:     lines.append(f"Original:   {r['original_chars']} chars  ~ {r['estimated_original_tokens']} tokens")
 88:     lines.append(f"Compressed: {r['compressed_chars']} chars  ~ {r['estimated_compressed_tokens']} tokens")
 89:     lines.append("")
 90:     lines.append(f"Savings: {r['tokens_saved']} tokens ({r['percent_token_savings']}%)")
 91:     if "price_per_million_tokens" in r:
 92:         lines.append("")
 93:         lines.append(f"At ${r['price_per_million_tokens']}/Mtok:")
 94:         lines.append(f"  Cost saved per response:   ${r['cost_saved_per_response_usd']:.6f}")
 95:         lines.append(f"  Cost saved per 1k responses: ${r['cost_saved_per_1k_responses_usd']:.4f}")
 96:     lines.append("")
 97:     lines.append("-" * 72)
 98:     lines.append("Compressed preview:")
 99:     lines.append(f"  {r['compressed_preview']}")
100:     return "\n".join(lines)
101: 
102: 
103: def main() -> int:
104:     parser = argparse.ArgumentParser(
105:         description="Estimate token + cost savings from caveman compression.",
106:         formatter_class=argparse.RawDescriptionHelpFormatter,
107:         epilog=__doc__,
108:     )
109:     price_help = "Per-million-token price (USD) to estimate cost savings"
110:     parser.add_argument("text", nargs="?", help="Input text (uses embedded sample if omitted)")
111:     parser.add_argument("--file", help="Read input from file")
112:     parser.add_argument("--output", choices=("text", "json"), default="text", help="Output format")
113:     parser.add_argument("--price-per-mtok", type=float, default=0.0, help=price_help)
114:     args = parser.parse_args()
115: 
116:     if args.file:
117:         try:
118:             with open(args.file, "r", encoding="utf-8") as f:
119:                 original = f.read()
120:         except (IOError, OSError) as e:
121:             print(f"error: {e}", file=sys.stderr)
122:             return 1
123:     elif args.text:
124:         original = args.text
125:     else:
126:         original = SAMPLE_INPUT
127: 
128:     result = analyze(original, args.price_per_mtok)
129:     if args.output == "json":
130:         print(json.dumps(result, indent=2))
131:     else:
132:         print(render_text(result))
133:     return 0
134: 
135: 
136: if __name__ == "__main__":
137:     sys.exit(main())
</file>

<file path=".claude/skills/caveman/SKILL.md">
 1: ---
 2: name: caveman
 3: description: >
 4:   Ultra-compressed communication mode. Cuts token usage ~75% by dropping
 5:   filler, articles, and pleasantries while keeping full technical accuracy.
 6:   Use when user says "caveman mode", "talk like caveman", "use caveman",
 7:   "less tokens", "be brief", or invokes /caveman.
 8: license: MIT
 9: metadata:
10:   derived_from: "https://github.com/mattpocock/skills/tree/main/skills/productivity/caveman"
11:   original_author: "Matt Pocock (@mattpocock)"
12:   original_license: MIT
13:   voice: "Matt Pocock — terse, fragment-OK, no filler"
14:   version: 1.0.0
15: ---
16: 
17: # Caveman Mode
18: 
19: > Derived from [Matt Pocock's caveman](https://github.com/mattpocock/skills/tree/main/skills/productivity/caveman) (MIT). Matt's voice preserved verbatim. Additions: compression tools + references + cs-* wrapper (see [references/companion_tooling.md](references/companion_tooling.md)).
20: 
21: Respond terse like smart caveman. All technical substance stay. Only fluff die.
22: 
23: ## Persistence
24: 
25: ACTIVE EVERY RESPONSE once triggered. No revert after many turns. No filler drift. Still active if unsure. Off only when user says "stop caveman" or "normal mode".
26: 
27: ## Rules
28: 
29: Drop: articles (a/an/the), filler (just/really/basically/actually/simply), pleasantries (sure/certainly/of course/happy to), hedging. Fragments OK. Short synonyms (big not extensive, fix not "implement a solution for"). Abbreviate common terms (DB/auth/config/req/res/fn/impl). Strip conjunctions. Use arrows for causality (X -> Y). One word when one word enough.
30: 
31: Technical terms stay exact. Code blocks unchanged. Errors quoted exact.
32: 
33: Pattern: `[thing] [action] [reason]. [next step].`
34: 
35: Not: "Sure! I'd be happy to help you with that. The issue you're experiencing is likely caused by..."
36: Yes: "Bug in auth middleware. Token expiry check use `<` not `<=`. Fix:"
37: 
38: ### Examples
39: 
40: **"Why React component re-render?"**
41: 
42: > Inline obj prop -> new ref -> re-render. `useMemo`.
43: 
44: **"Explain database connection pooling."**
45: 
46: > Pool = reuse DB conn. Skip handshake -> fast under load.
47: 
48: ## Auto-Clarity Exception
49: 
50: Drop caveman temporarily for: security warnings, irreversible action confirmations, multi-step sequences where fragment order risks misread, user asks to clarify or repeats question. Resume caveman after clear part done.
51: 
52: Example -- destructive op:
53: 
54: > **Warning:** This will permanently delete all rows in the `users` table and cannot be undone.
55: >
56: > ```sql
57: > DROP TABLE users;
58: > ```
59: >
60: > Caveman resume. Verify backup exist first.
61: 
62: ## Tooling
63: 
64: See [references/companion_tooling.md](references/companion_tooling.md). Tools: compressor + estimator + lint. Agent: `cs-caveman-mode`. Command: `/cs:caveman`.
65: 
66: ---
67: 
68: **Version:** 1.0.0
69: **Derived:** Matt Pocock (MIT) + this repo's wrapper
</file>

