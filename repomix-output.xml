111:     $syncPath = Join-Path $raiz "scripts\$sync"
112:     if (Test-Path $syncPath) {
113:         if (Get-Command node -ErrorAction SilentlyContinue) {
114:             node $syncPath
115:         } else {
116:             Write-Warning "node nao encontrado, pulando: $sync"
117:         }
118:     } else {
119:         Write-Output "Ausente (opcional), pulando: scripts\$sync"
120:     }
121: }
122: 
123: Write-Output "`n== Hook pre-commit (R15/R16 - copia, .git\hooks nao aceita link) =="
124: $hookSrc = Join-Path $raiz "scripts\hooks\pre-commit"
125: $hookDst = Join-Path $raiz ".git\hooks\pre-commit"
126: if ((Test-Path $hookSrc) -and (Test-Path (Join-Path $raiz ".git"))) {
127:     Copy-Item -Path $hookSrc -Destination $hookDst -Force
128:     Write-Output "Copiado: scripts\hooks\pre-commit -> .git\hooks\pre-commit"
129: } else {
130:     Write-Warning "Hook ou .git ausente, pulando copia do pre-commit"
131: }
132: 
133: Write-Output "`nConcluido."
</file>

<file path="scripts/setup-links.sh">
  1: #!/usr/bin/env bash
  2: # Recria os links de portabilidade multi-IDE do projeto (macOS/Linux).
  3: # Idempotente. Aqui symlink real de arquivo e de pasta funciona sem privilegio elevado,
  4: # entao usamos symlink em todos os casos (equivalente ao hardlink+junction do Windows).
  5: #
  6: # Uso: bash scripts/setup-links.sh [nome-da-regra]
  7: #      nome-da-regra = slug usado em .cursor/rules e .windsurf/rules (padrao: projeto)
  8: #
  9: # Universal: tudo que nao existir no projeto e PULADO com aviso, nunca com erro.
 10: set -euo pipefail
 11: 
 12: raiz="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
 13: cd "$raiz"
 14: 
 15: rule="${1:-projeto}"
 16: 
 17: link() {
 18:   local alvo="$1" link="$2"
 19:   if [ ! -e "$alvo" ]; then
 20:     echo "AVISO: alvo nao encontrado, pulando: $alvo"
 21:     return
 22:   fi
 23:   mkdir -p "$(dirname "$link")"
 24:   if [ -L "$link" ]; then
 25:     echo "OK (ja e symlink): $link"
 26:     return
 27:   fi
 28:   if [ -e "$link" ]; then
 29:     echo "AVISO: ja existe e NAO e symlink, pulando (apague manualmente se quiser recriar): $link"
 30:     return
 31:   fi
 32:   ln -s "$(realpath --relative-to="$(dirname "$link")" "$alvo")" "$link"
 33:   echo "Criado symlink: $link -> $alvo"
 34: }
 35: 
 36: echo "== Fonte unica de governanca (.claude/CLAUDE.md -> CLAUDE.md da raiz) =="
 37: # A fonte canonica e .claude/CLAUDE.md. O CLAUDE.md da raiz e o primeiro espelho —
 38: # precisa existir antes dos demais, que sao linkados a partir dele.
 39: link ".claude/CLAUDE.md" "CLAUDE.md"
 40: 
 41: echo
 42: echo "== Arquivos de instrucao (symlink para CLAUDE.md) =="
 43: link "CLAUDE.md" "AGENTS.md"
 44: link "CLAUDE.md" ".cursor/rules/${rule}.mdc"
 45: link "CLAUDE.md" ".windsurfrules"
 46: link "CLAUDE.md" ".windsurf/rules/${rule}.md"
 47: link "CLAUDE.md" ".clinerules"
 48: link "CLAUDE.md" ".github/copilot-instructions.md"
 49: 
 50: echo
 51: echo "== MCP (symlink para .mcp.json, schema compativel) =="
 52: link ".mcp.json" ".cursor/mcp.json"
 53: 
 54: echo
 55: echo "== Pastas neutras (symlink para .claude/...) =="
 56: link ".claude/skills" "agentic/skills"
 57: link ".claude/agents" "agentic/agents"
 58: link ".claude/commands" "agentic/commands"
 59: link ".claude/mcp-servers" "agentic/mcp-servers"
 60: 
 61: echo
 62: echo "== Pastas .agents/ (symlink para .claude/..., harnesses alternativos) =="
 63: # NAO expor skills/ e mcp-servers/ aqui: .agents/ e o diretorio de agentes do
 64: # Codebuff/Freebuff, que importa e executa os .js/.mjs que encontra dentro dele.
 65: # Um script que roda no import e chama process.exit(1) derruba o CLI inteiro.
 66: # Apenas agents/ e commands/ (somente .md) sao seguros aqui.
 67: # Skills e MCP servers seguem disponiveis via agentic/ e .opencode/.
 68: link ".claude/agents" ".agents/agents"
 69: link ".claude/commands" ".agents/commands"
 70: 
 71: echo
 72: echo "== Pastas .opencode/ (symlink para .claude/..., OpenCode) =="
 73: link ".claude/skills" ".opencode/skills"
 74: link ".claude/agents" ".opencode/agents"
 75: link ".claude/commands" ".opencode/commands"
 76: link ".claude/mcp-servers" ".opencode/mcp-servers"
 77: link ".claude/settings.json" ".opencode/settings.json"
 78: 
 79: echo
 80: echo "== MCP traduzido (schemas diferentes, gerados por script — opcional) =="
 81: # Estes sincronizadores sao ESPECIFICOS do projeto: se nao existirem, pula.
 82: for sync in sincronizar-mcp-vscode.mjs sincronizar-mcp-opencode.mjs; do
 83:   if [ -f "$raiz/scripts/$sync" ]; then
 84:     if command -v node >/dev/null 2>&1; then
 85:       node "$raiz/scripts/$sync"
 86:     else
 87:       echo "AVISO: node nao encontrado, pulando: $sync"
 88:     fi
 89:   else
 90:     echo "Ausente (opcional), pulando: scripts/$sync"
 91:   fi
 92: done
 93: 
 94: echo
 95: echo "== Hook pre-commit (R15/R16 - copia, .git/hooks nao aceita link) =="
 96: if [ -f "$raiz/scripts/hooks/pre-commit" ] && [ -d "$raiz/.git" ]; then
 97:   cp "$raiz/scripts/hooks/pre-commit" "$raiz/.git/hooks/pre-commit"
 98:   chmod +x "$raiz/.git/hooks/pre-commit"
 99:   echo "Copiado: scripts/hooks/pre-commit -> .git/hooks/pre-commit"
100: else
101:   echo "AVISO: hook ou .git ausente, pulando copia do pre-commit"
102: fi
103: 
104: echo
105: echo "Concluido."
</file>

<file path="scripts/validate.py">
  1: #!/usr/bin/env python3
  2: """
  3: validate: valida a integracao da fabrica-universal em um projeto consumidor.
  4: Entrada: raiz do projeto (padrao: diretorio atual, ou --raiz <path>)
  5: Saida:   relatorio no console + validate-report.json (a menos que --sem-json)
  6: Garantias: idempotente, sem side effects (so escreve o relatorio), exit 0 = sucesso.
  7: 
  8: Uso:
  9:     python scripts/validate.py                 # valida o diretorio atual
 10:     python scripts/validate.py --raiz ../meu   # valida outro projeto
 11:     python scripts/validate.py --estrito       # avisos tambem reprovam
 12: """
 13: 
 14: import argparse
 15: import json
 16: import subprocess
 17: import sys
 18: from pathlib import Path
 19: 
 20: SKILLS_ECONOMIA = ["caveman", "headroom", "lean-ctx", "rtk-memory", "pre-flight-check"]
 21: 
 22: OK, AVISO, FALHA = "ok", "aviso", "falha"
 23: 
 24: SIMBOLO = {OK: "[OK]  ", AVISO: "[!]   ", FALHA: "[X]   "}
 25: 
 26: 
 27: def console_utf8():
 28:     """Windows: sem isto, qualquer print nao-ASCII quebra em cp1252."""
 29:     for f in (sys.stdout, sys.stderr):
 30:         try:
 31:             f.reconfigure(encoding="utf-8", errors="replace")
 32:         except Exception:
 33:             pass
 34: 
 35: 
 36: class Relatorio:
 37:     def __init__(self):
 38:         self.checks = []
 39: 
 40:     def add(self, nome, estado, detalhe=""):
 41:         self.checks.append({"check": nome, "estado": estado, "detalhe": detalhe})
 42:         print(f"{SIMBOLO[estado]}{nome}" + (f" — {detalhe}" if detalhe else ""))
 43: 
 44:     def conta(self, estado):
 45:         return sum(1 for c in self.checks if c["estado"] == estado)
 46: 
 47: 
 48: def check_claude_md(raiz, rel):
 49:     """CLAUDE.md precisa existir e carregar sempre (alwaysApply: true)."""
 50:     candidatos = [raiz / ".claude" / "CLAUDE.md", raiz / "CLAUDE.md"]
 51:     achados = [p for p in candidatos if p.is_file()]
 52:     if not achados:
 53:         rel.add("CLAUDE.md presente", FALHA, "nem .claude/CLAUDE.md nem CLAUDE.md")
 54:         return
 55:     alvo = achados[0]
 56:     texto = alvo.read_text(encoding="utf-8", errors="replace")
 57:     if "alwaysApply: true" in texto:
 58:         rel.add("CLAUDE.md presente", OK, str(alvo.relative_to(raiz)))
 59:     else:
 60:         rel.add("CLAUDE.md presente", FALHA,
 61:                 f"{alvo.relative_to(raiz)} sem 'alwaysApply: true' no frontmatter")
 62:         return
 63:     if "<SEU-PROJETO>" in texto or "[CUSTOMIZAR]" in texto:
 64:         rel.add("CLAUDE.md customizado", AVISO,
 65:                 "ainda contem placeholders (<SEU-PROJETO> / [CUSTOMIZAR])")
 66:     else:
 67:         rel.add("CLAUDE.md customizado", OK)
 68: 
 69: 
 70: def check_skills(raiz, rel):
 71:     base = raiz / ".claude" / "skills"
 72:     faltando = [s for s in SKILLS_ECONOMIA if not (base / s / "SKILL.md").is_file()]
 73:     if faltando:
 74:         rel.add("Skills de economia (5)", FALHA, "faltando: " + ", ".join(faltando))
 75:     else:
 76:         rel.add("Skills de economia (5)", OK, ", ".join(SKILLS_ECONOMIA))
 77: 
 78: 
 79: def check_python(raiz, rel):
 80:     scripts = sorted((raiz / "scripts").glob("*.py")) if (raiz / "scripts").is_dir() else []
 81:     if not scripts:
 82:         rel.add("Sintaxe Python (scripts/)", AVISO, "nenhum .py em scripts/")
 83:         return
 84:     quebrados = []
 85:     for s in scripts:
 86:         r = subprocess.run([sys.executable, "-m", "py_compile", str(s)],
 87:                            capture_output=True, text=True)
 88:         if r.returncode != 0:
 89:             quebrados.append(s.name)
 90:     if quebrados:
 91:         rel.add("Sintaxe Python (scripts/)", FALHA, "erro em: " + ", ".join(quebrados))
 92:     else:
 93:         rel.add("Sintaxe Python (scripts/)", OK, f"{len(scripts)} arquivo(s)")
 94: 
 95: 
 96: def check_portabilidade(raiz, rel):
 97:     """setup-links deve ter rodado: agentic/ aponta para .claude/."""
 98:     links = raiz / "agentic" / "skills"
 99:     if links.exists():
100:         rel.add("Portabilidade (agentic/)", OK)
101:     else:
102:         rel.add("Portabilidade (agentic/)", AVISO,
103:                 "rode scripts/setup-links.ps1 (Win) ou setup-links.sh (Mac/Linux)")
104: 
105:     espelho = raiz / "AGENTS.md"
106:     if espelho.exists():
107:         rel.add("Espelho AGENTS.md", OK)
108:     else:
109:         rel.add("Espelho AGENTS.md", AVISO, "hardlink/symlink de CLAUDE.md ausente")
110: 
111: 
112: def check_hook(raiz, rel):
113:     fonte = raiz / "scripts" / "hooks" / "pre-commit"
114:     instalado = raiz / ".git" / "hooks" / "pre-commit"
115:     if not fonte.is_file():
116:         rel.add("Hook pre-commit (fonte)", FALHA, "scripts/hooks/pre-commit ausente")
117:     else:
118:         rel.add("Hook pre-commit (fonte)", OK)
119:     if instalado.is_file():
120:         rel.add("Hook pre-commit (instalado)", OK)
121:     else:
122:         rel.add("Hook pre-commit (instalado)", AVISO,
123:                 ".git/hooks/pre-commit ausente — rode setup-links")
124: 
125: 
126: def check_scripts_universais(raiz, rel):
127:     esperados = ["setup-links.ps1", "setup-links.sh", "validate.py"]
128:     faltando = [n for n in esperados if not (raiz / "scripts" / n).is_file()]
129:     if faltando:
130:         rel.add("Scripts universais", AVISO, "faltando: " + ", ".join(faltando))
131:     else:
132:         rel.add("Scripts universais", OK, ", ".join(esperados))
133: 
134: 
135: def main():
136:     console_utf8()
137:     ap = argparse.ArgumentParser(description="Valida a integracao da fabrica-universal.")
138:     ap.add_argument("--raiz", default=".", help="raiz do projeto a validar")
139:     ap.add_argument("--estrito", action="store_true", help="avisos tambem reprovam")
140:     ap.add_argument("--sem-json", action="store_true", help="nao gravar validate-report.json")
141:     args = ap.parse_args()
142: 
143:     raiz = Path(args.raiz).resolve()
144:     print(f"Validando: {raiz}\n")
145: 
146:     rel = Relatorio()
147:     resultado = {"raiz": str(raiz), "status": "falha", "checks": rel.checks}
148:     try:
149:         check_claude_md(raiz, rel)
150:         check_skills(raiz, rel)
151:         check_scripts_universais(raiz, rel)
152:         check_python(raiz, rel)
153:         check_portabilidade(raiz, rel)
154:         check_hook(raiz, rel)
155: 
156:         falhas, avisos = rel.conta(FALHA), rel.conta(AVISO)
157:         reprovado = falhas > 0 or (args.estrito and avisos > 0)
158:         resultado["status"] = "falha" if reprovado else "sucesso"
159:         resultado["falhas"], resultado["avisos"] = falhas, avisos
160: 
161:         print()
162:         if reprovado:
163:             print(f"REPROVADO — {falhas} falha(s), {avisos} aviso(s)")
164:         else:
165:             print(f"Setup validado — {avisos} aviso(s)")
166:     finally:
167:         if not args.sem_json:
168:             (raiz / "validate-report.json").write_text(
169:                 json.dumps(resultado, ensure_ascii=False, indent=2), encoding="utf-8")
170: 
171:     return 0 if resultado["status"] == "sucesso" else 1
172: 
173: 
174: if __name__ == "__main__":
175:     sys.exit(main())
</file>

