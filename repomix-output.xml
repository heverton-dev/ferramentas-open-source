<file path="scripts/pdf_typst.py">
 1: #!/usr/bin/env python3
 2: """
 3: Conversao Markdown -> PDF via Pandoc -> .typ -> Typst (Fabrica Agentica de Livros).
 4: 
 5: Por que existe: `pandoc --pdf-engine=typst` extrai as imagens do documento para uma
 6: pasta temporaria e reescreve os caminhos em forma ABSOLUTA. O Typst recusa caminho
 7: absoluto no Windows ("path contains invalid component `C:`"), entao qualquer livro com
 8: figuras (por exemplo os diagramas Mermaid renderizados pelo Upgrade 2) falha na
 9: compilacao. Gerando o `.typ` intermediario dentro da pasta do livro, os caminhos
10: relativos das figuras continuam validos.
11: 
12: Uso (drop-in no lugar de subprocess.run(comando, ...) dos compiladores):
13: 
14:     from pdf_typst import executar
15:     resultado = executar(comando, pdf_path, dir_livro, TYPST, timeout=600)
16:     # resultado.stderr / resultado.returncode seguem disponiveis
17: """
18: 
19: import subprocess
20: from pathlib import Path
21: 
22: 
23: class Resultado:
24:     """Compativel com o subprocess.CompletedProcess usado pelos compiladores."""
25: 
26:     def __init__(self, returncode, stdout="", stderr=""):
27:         self.returncode = returncode
28:         self.stdout = stdout
29:         self.stderr = stderr
30: 
31: 
32: def _sem_motor_pdf(comando, typ_path):
33:     """Remove --pdf-engine e redireciona a saida (-o) para o .typ intermediario."""
34:     novo = []
35:     i = 0
36:     while i < len(comando):
37:         arg = str(comando[i])
38:         if arg == "--pdf-engine":
39:             i += 2
40:             continue
41:         if arg.startswith("--pdf-engine="):
42:             i += 1
43:             continue
44:         if arg == "-o" or arg == "--output":
45:             novo += [arg, str(typ_path)]
46:             i += 2
47:             continue
48:         if arg.startswith("--output="):
49:             novo.append(f"--output={typ_path}")
50:             i += 1
51:             continue
52:         novo.append(arg)
53:         i += 1
54:     return novo
55: 
56: 
57: def executar(comando, pdf_path, dir_raiz, typst_bin, timeout=600, manter_typ=False):
58:     """Roda Pandoc -> .typ e depois typst compile --root <dir_raiz>.
59: 
60:     Retorna um objeto com returncode/stdout/stderr, como subprocess.run.
61:     """
62:     pdf_path = Path(pdf_path)
63:     dir_raiz = Path(dir_raiz)
64:     typ_path = dir_raiz / f"_{pdf_path.stem}.typ"
65: 
66:     pandoc = subprocess.run(_sem_motor_pdf(comando, typ_path),
67:                             capture_output=True, text=True, timeout=timeout)
68:     if not typ_path.exists() or typ_path.stat().st_size == 0:
69:         return Resultado(pandoc.returncode or 1, pandoc.stdout,
70:                          (pandoc.stderr or "") + "\npandoc nao gerou o .typ intermediario")
71: 
72:     typst = subprocess.run(
73:         [str(typst_bin), "compile", "--root", str(dir_raiz), str(typ_path), str(pdf_path)],
74:         capture_output=True, text=True, timeout=timeout,
75:     )
76:     if not manter_typ and pdf_path.exists() and pdf_path.stat().st_size > 0:
77:         typ_path.unlink(missing_ok=True)
78: 
79:     return Resultado(typst.returncode,
80:                      (pandoc.stdout or "") + (typst.stdout or ""),
81:                      (pandoc.stderr or "") + (typst.stderr or ""))
</file>

<file path="scripts/setup-links.ps1">
  1: # Recria os links de portabilidade multi-IDE do projeto (Windows).
  2: # Idempotente: pode ser rodado quantas vezes quiser. Usa HARDLINK para arquivos e
  3: # JUNCTION para pastas porque symlink real de ARQUIVO exige privilegio de administrador
  4: # neste SO; junction de pasta e hardlink de arquivo nao exigem elevacao.
  5: #
  6: # Uso:  powershell -ExecutionPolicy Bypass -File scripts\setup-links.ps1
  7: #
  8: # Universal: tudo que nao existir no projeto e PULADO com aviso, nunca com erro.
  9: 
 10: param(
 11:     # Nome do arquivo de regra gerado em .cursor\rules e .windsurf\rules.
 12:     # Trocar pelo slug do seu projeto (ex.: "minha-fabrica").
 13:     [string]$RuleName = "projeto"
 14: )
 15: 
 16: $ErrorActionPreference = "Stop"
 17: $raiz = Split-Path -Parent $PSScriptRoot
 18: 
 19: function Set-HardLink($linkRelativo, $targetRelativo) {
 20:     $link = Join-Path $raiz $linkRelativo
 21:     $target = Join-Path $raiz $targetRelativo
 22:     if (-not (Test-Path $target)) {
 23:         Write-Warning "Alvo nao encontrado, pulando: $targetRelativo"
 24:         return
 25:     }
 26:     $linkDir = Split-Path -Parent $link
 27:     if (-not (Test-Path $linkDir)) { New-Item -ItemType Directory -Force -Path $linkDir | Out-Null }
 28:     if (Test-Path $link) {
 29:         # LinkType == "HardLink" so diz que o arquivo E um hardlink de ALGUEM - nao
 30:         # garante que ainda aponta pro TARGET atual. Um editor que salva com
 31:         # write-novo-arquivo+rename (comum) desvincula o inode em silencio: o
 32:         # arquivo continua "sendo hardlink" de outros espelhos, so que nao mais
 33:         # deste CLAUDE.md. Por isso o criterio de verdade e o HASH do conteudo,
 34:         # nao o LinkType.
 35:         $hashLink = (Get-FileHash -Path $link -Algorithm SHA256).Hash
 36:         $hashTarget = (Get-FileHash -Path $target -Algorithm SHA256).Hash
 37:         if ($hashLink -eq $hashTarget) {
 38:             Write-Output "OK (conteudo em dia): $linkRelativo"
 39:             return
 40:         }
 41:         Write-Warning "Desalinhado do alvo (hardlink quebrado por rewrite externo) - recriando: $linkRelativo"
 42:         Remove-Item -Path $link -Force
 43:     }
 44:     New-Item -ItemType HardLink -Path $link -Target $target | Out-Null
 45:     Write-Output "Criado hardlink: $linkRelativo -> $targetRelativo"
 46: }
 47: 
 48: function Set-Junction($linkRelativo, $targetRelativo) {
 49:     $link = Join-Path $raiz $linkRelativo
 50:     $target = Join-Path $raiz $targetRelativo
 51:     if (-not (Test-Path $target)) {
 52:         Write-Warning "Alvo nao encontrado, pulando: $targetRelativo"
 53:         return
 54:     }
 55:     $linkParent = Split-Path -Parent $link
 56:     if (-not (Test-Path $linkParent)) { New-Item -ItemType Directory -Force -Path $linkParent | Out-Null }
 57:     if (Test-Path $link) {
 58:         $item = Get-Item $link -Force
 59:         if ($item.LinkType -eq "Junction") {
 60:             Write-Output "OK (ja e junction): $linkRelativo"
 61:             return
 62:         }
 63:         Write-Warning "Ja existe e NAO e junction, pulando (apague manualmente se quiser recriar): $linkRelativo"
 64:         return
 65:     }
 66:     New-Item -ItemType Junction -Path $link -Target $target | Out-Null
 67:     Write-Output "Criada junction: $linkRelativo -> $targetRelativo"
 68: }
 69: 
