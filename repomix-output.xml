<file path="scripts/padroes/mcp-template.js">
  1: #!/usr/bin/env node
  2: /**
  3:  * <seu-mcp>: MCP server minimo (stdio) — template.
  4:  *
  5:  * Por que um MCP e nao um script: use MCP quando o agente precisa consultar
  6:  * ESTADO ao vivo ou executar uma acao com efeito colateral controlado, varias
  7:  * vezes numa mesma sessao. Para transformacao pura de arquivo, um script Python
  8:  * (scripts/padroes/script-template.py) e mais barato e mais testavel (R8).
  9:  *
 10:  * Registro em `.mcp.json` na raiz do projeto:
 11:  *
 12:  *   {
 13:  *     "mcpServers": {
 14:  *       "<seu-mcp>": {
 15:  *         "command": "node",
 16:  *         "args": ["scripts/mcp/<seu-mcp>.js"]
 17:  *       }
 18:  *     }
 19:  *   }
 20:  *
 21:  * Depois de editar `.mcp.json`, rodar scripts/setup-links.* para propagar o
 22:  * espelho `.cursor/mcp.json` (hardlink) e gerar os schemas divergentes
 23:  * (.vscode/mcp.json, opencode.json).
 24:  *
 25:  * Dependencia: npm i @modelcontextprotocol/sdk
 26:  */
 27: 
 28: import { Server } from "@modelcontextprotocol/sdk/server/index.js";
 29: import { StdioServerTransport } from "@modelcontextprotocol/sdk/server/stdio.js";
 30: import {
 31:   CallToolRequestSchema,
 32:   ListToolsRequestSchema,
 33: } from "@modelcontextprotocol/sdk/types.js";
 34: 
 35: const server = new Server(
 36:   { name: "<seu-mcp>", version: "1.0.0" },
 37:   { capabilities: { tools: {} } }
 38: );
 39: 
 40: // --- Catalogo de tools -----------------------------------------------------
 41: // A description e o unico texto que o agente le para decidir chamar a tool.
 42: // Diga o que ela FAZ e QUANDO usar; nao repita o nome.
 43: const TOOLS = [
 44:   {
 45:     name: "<sua_tool>",
 46:     description:
 47:       "<O que faz e quando usar. Ex.: 'Le o estado atual da esteira e retorna " +
 48:       "os itens pendentes. Use antes de decidir o proximo lote.'>",
 49:     inputSchema: {
 50:       type: "object",
 51:       properties: {
 52:         alvo: { type: "string", description: "<o que identifica o item>" },
 53:         estrito: { type: "boolean", description: "avisos tambem reprovam", default: false },
 54:       },
 55:       required: ["alvo"],
 56:     },
 57:   },
 58: ];
 59: 
 60: server.setRequestHandler(ListToolsRequestSchema, async () => ({ tools: TOOLS }));
 61: 
 62: // --- Implementacao ---------------------------------------------------------
 63: server.setRequestHandler(CallToolRequestSchema, async (request) => {
 64:   const { name, arguments: args } = request.params;
 65: 
 66:   try {
 67:     switch (name) {
 68:       case "<sua_tool>": {
 69:         // ==== SUA LOGICA AQUI ====
 70:         const resultado = { alvo: args.alvo, status: "sucesso", itens: [] };
 71:         return {
 72:           content: [{ type: "text", text: JSON.stringify(resultado, null, 2) }],
 73:         };
 74:       }
 75:       default:
 76:         throw new Error(`tool desconhecida: ${name}`);
 77:     }
 78:   } catch (e) {
 79:     // Erro vira resposta com isError, nao excecao solta: excecao derruba o
 80:     // servidor e o agente perde a sessao inteira do MCP.
 81:     return {
 82:       isError: true,
 83:       content: [{ type: "text", text: `${e.name}: ${e.message}` }],
 84:     };
 85:   }
 86: });
 87: 
 88: // --- Boot ------------------------------------------------------------------
 89: // stdio: NUNCA escrever em stdout fora do protocolo (um console.log solto
 90: // corrompe o frame JSON-RPC). Log de diagnostico vai em stderr.
 91: async function main() {
 92:   const transport = new StdioServerTransport();
 93:   await server.connect(transport);
 94:   console.error("<seu-mcp> pronto (stdio)");
 95: }
 96: 
 97: main().catch((e) => {
 98:   console.error("falha ao iniciar <seu-mcp>:", e);
 99:   process.exit(1);
100: });
</file>

<file path="scripts/padroes/script-template.py">
 1: #!/usr/bin/env python3
 2: """
 3: <modulo>: <descricao em uma linha>
 4: Entrada: <input>
 5: Saida:   <output.json>
 6: Garantias: idempotente, sem side effects fora da saida declarada, exit 0 = sucesso.
 7: 
 8: Uso:
 9:     python scripts/<modulo>.py <alvo>
10:     python scripts/<modulo>.py <alvo> --estrito
11: """
12: 
13: import argparse
14: import json
15: import sys
16: from pathlib import Path
17: 
18: 
19: def console_utf8():
20:     """Windows: sem isto, qualquer print nao-ASCII quebra em cp1252 (R11 do CLAUDE.md).
21: 
22:     OBRIGATORIO em todo script com print/emoji. Chamar como primeira linha de main().
23:     """
24:     for f in (sys.stdout, sys.stderr):
25:         try:
26:             f.reconfigure(encoding="utf-8", errors="replace")
27:         except Exception:
28:             pass
29: 
30: 
31: def caminho_relatorio(alvo):
32:     return Path("relatorios") / f"<modulo>-{Path(alvo).stem}.json"
33: 
34: 
35: def executar(alvo, estrito=False):
36:     """Logica do script. Retorna (ok: bool, dados: dict).
37: 
38:     Toda a regra de negocio mora aqui — main() so cuida de I/O e exit code,
39:     para que esta funcao seja testavel sem subprocess.
40:     """
41:     dados = {"alvo": str(alvo), "problemas": [], "avisos": []}
42: 
43:     # ==== SUA LOGICA AQUI ====
44:     # dados["problemas"].append({"onde": ..., "o_que": ..., "como_corrigir": ...})
45:     # dados["avisos"].append(...)
46: 
47:     reprovado = bool(dados["problemas"]) or (estrito and bool(dados["avisos"]))
48:     return (not reprovado), dados
49: 
50: 
51: def main():
52:     console_utf8()
53:     ap = argparse.ArgumentParser(description=__doc__.splitlines()[1])
54:     ap.add_argument("alvo", help="<o que este script recebe>")
55:     ap.add_argument("--estrito", action="store_true", help="avisos tambem reprovam")
56:     ap.add_argument("--silencioso", action="store_true", help="so o exit code importa")
57:     args = ap.parse_args()
58: 
59:     # O relatorio e gravado SEMPRE — inclusive em excecao. Um gate que morre sem
60:     # relatorio e indistinguivel de um gate que nunca rodou.
61:     relatorio = {"status": "falha", "erro": None}
62:     try:
63:         ok, dados = executar(args.alvo, estrito=args.estrito)
64:         relatorio.update(dados)
65:         relatorio["status"] = "sucesso" if ok else "falha"
66:     except Exception as e:
67:         relatorio["erro"] = f"{type(e).__name__}: {e}"
68:         raise
69:     finally:
70:         destino = caminho_relatorio(args.alvo)
71:         destino.parent.mkdir(parents=True, exist_ok=True)
72:         destino.write_text(json.dumps(relatorio, ensure_ascii=False, indent=2),
73:                            encoding="utf-8")
74:         if not args.silencioso:
75:             for p in relatorio.get("problemas", []):
76:                 print(f"[X] {p}")
77:             for a in relatorio.get("avisos", []):
78:                 print(f"[!] {a}")
79:             print(f"status={relatorio['status']} relatorio={destino}")
80: 
81:     return 0 if relatorio["status"] == "sucesso" else 1
82: 
83: 
84: if __name__ == "__main__":
85:     sys.exit(main())
</file>

