389:         <div class="entry-rank">06</div>
390:         <div class="entry-body">
391:           <div class="entry-top">
392:             <h3>Chroma</h3>
393:             <span class="lic-badge">Apache-2.0</span>
394:             <span class="kind">Embedding Database · Python / Rust</span>
395:           </div>
396:           <div class="cols">
