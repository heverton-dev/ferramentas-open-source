  1: #!/usr/bin/env python3
  2: """caveman_lint.py — Lint a response for caveman-mode compliance.
  3: 
  4: Stdlib-only. Detects banned vocabulary in a response that's supposed to be in
  5: caveman mode. Returns specific findings + verdict.
  6: 
  7: Banned categories per Matt Pocock's caveman rules:
  8:   - Pleasantries (sure, certainly, of course, happy to)
  9:   - Filler (just, really, basically, actually, simply)
 10:   - Hedging (might, maybe, perhaps, likely)
 11:   - Metatalk (as you can see, worth noting)
 12:   - Verbose phrases ("the implementation of a solution for")
 13: 
 14: Whitelist (NOT banned even in caveman mode):
 15:   - Words inside code blocks
 16:   - Words inside inline code
 17:   - Words inside quoted strings
 18:   - Caveman exception zones (security warnings, destructive op confirmations)
 19: 
 20: Usage:
 21:     python caveman_lint.py                          # uses embedded samples
 22:     python caveman_lint.py "response text"
 23:     python caveman_lint.py --file path/to/response.txt
 24:     python caveman_lint.py "text" --output json
 25: """
 26: 
 27: import argparse
 28: import json
 29: import re
 30: import sys
 31: from typing import Any, Dict, List
 32: 
 33: 
 34: BANNED_PHRASES = {
 35:     "pleasantry": [
 36:         "sure!", "sure,", "certainly", "of course", "happy to help",
 37:         "i'd be happy", "i would be happy", "great question", "good question",
 38:         "absolutely", "no problem!",
 39:     ],
 40:     "filler": ["just", "really", "basically", "actually", "simply", "obviously", "literally"],
 41:     "hedging": ["might", "maybe", "perhaps", "likely", "possibly", "probably"],
 42:     "metatalk": [
 43:         "as you can see", "it should be noted", "worth mentioning",
 44:         "needless to say", "to be clear", "in other words",
 45:         "that said", "having said that",
 46:     ],
 47:     "verbose": [
 48:         "implement a solution for", "the implementation of",
 49:         "in order to", "for the purpose of", "with respect to",
 50:         "due to the fact that",
 51:     ],
 52: }
 53: 
 54: # Patterns that DROP caveman temporarily (whitelisted zones)
 55: EXCEPTION_MARKERS = [
 56:     re.compile(r"\*\*warning:\*\*", re.IGNORECASE),
 57:     re.compile(r"\bdestructive\b", re.IGNORECASE),
 58:     re.compile(r"\birreversible\b", re.IGNORECASE),
 59:     re.compile(r"\bcannot be undone\b", re.IGNORECASE),
 60: ]
 61: 
 62: 
 63: SAMPLE_BAD = (
 64:     "Sure! I'd be happy to help. The issue is actually quite simple — basically, "
 65:     "you just need to update the configuration. It's worth mentioning that this might "
 66:     "cause a slight performance hit, but probably not noticeable."
 67: )
 68: SAMPLE_GOOD = "Bug in auth middleware. Token expiry check use `<` not `<=`. Fix: change to `<=`."
 69: 
 70: 
 71: def _protect_code(text: str) -> str:
 72:     """Mask code blocks + inline code so banned-word matching skips them."""
 73:     text = re.sub(r"```.*?```", lambda m: "\x00" * len(m.group(0)), text, flags=re.DOTALL)
 74:     text = re.sub(r"`[^`]+`", lambda m: "\x00" * len(m.group(0)), text)
 75:     return text
 76: 
 77: 
 78: def _has_exception_context(text: str) -> bool:
 79:     return any(p.search(text) for p in EXCEPTION_MARKERS)
 80: 
 81: 
 82: def _count_phrase(phrase: str, masked: str) -> int:
 83:     return len(re.findall(r"\b" + re.escape(phrase) + r"\b", masked, re.IGNORECASE))
 84: 
 85: 
 86: def _violation_record(category: str, phrase: str, count: int) -> Dict[str, Any]:
 87:     return {"category": category, "phrase": phrase, "count": count}
 88: 
 89: 
 90: def find_violations(text: str) -> List[Dict[str, Any]]:
 91:     """Find banned phrases. Returns list of {category, phrase, count}."""
 92:     masked = _protect_code(text)
 93:     violations: List[Dict[str, Any]] = []
 94:     for category, phrases in BANNED_PHRASES.items():
 95:         for phrase in phrases:
 96:             count = _count_phrase(phrase, masked)
 97:             if count > 0:
 98:                 violations.append(_violation_record(category, phrase, count))
 99:     return violations
100: 
101: 
102: def analyze(text: str) -> Dict[str, Any]:
103:     violations = find_violations(text)
104:     total_violations = sum(v["count"] for v in violations)
105:     has_exception = _has_exception_context(text)
106: 
107:     # Verdict logic:
108:     #   0 violations + reasonable length     -> CLEAN
109:     #   <= 2 violations OR exception context -> WARN
110:     #   >  2 violations                      -> FAIL
111:     if total_violations == 0:
112:         verdict = "CLEAN"
113:     elif has_exception:
114:         verdict = "WARN"
115:         # When there's a security warning, some normal language is allowed
116:     elif total_violations <= 2:
117:         verdict = "WARN"
118:     else:
119:         verdict = "FAIL"
120: 
121:     return {
122:         "char_count": len(text),
123:         "word_count": len(text.split()),
124:         "violation_categories": sorted(set(v["category"] for v in violations)),
125:         "total_violations": total_violations,
126:         "has_exception_context": has_exception,
127:         "violations": violations,
128:         "verdict": verdict,
129:     }
130: 
131: 
132: def render_text(text: str, r: Dict[str, Any]) -> str:
133:     lines = []
134:     lines.append("=" * 72)
135:     lines.append("CAVEMAN LINT")
136:     lines.append("=" * 72)
137:     lines.append("")
138:     preview = text[:200] + ("..." if len(text) > 200 else "")
139:     lines.append(f"Text ({r['char_count']} chars, {r['word_count']} words):")
140:     lines.append(f"  {preview}")
141:     lines.append("")
142:     lines.append("-" * 72)
143:     lines.append(f"Violations: {r['total_violations']}")
144:     lines.append(f"Categories hit: {r['violation_categories']}")
145:     if r["has_exception_context"]:
146:         lines.append("Exception context detected (warning/destructive zone — some prose allowed)")
147:     lines.append("")
148:     if r["violations"]:
149:         for v in r["violations"]:
150:             lines.append(f"  [{v['category']:11s}] x{v['count']:2d}  '{v['phrase']}'")
151:     else:
152:         lines.append("  No banned phrases found.")
153:     lines.append("")
154:     lines.append("-" * 72)
155:     lines.append(f"Verdict: {r['verdict']}")
156:     return "\n".join(lines)
157: 
158: 
159: def main() -> int:
160:     parser = argparse.ArgumentParser(
161:         description="Lint a response for caveman-mode compliance.",
162:         formatter_class=argparse.RawDescriptionHelpFormatter,
163:         epilog=__doc__,
164:     )
165:     parser.add_argument("text", nargs="?", help="Input text (uses embedded sample if omitted)")
166:     parser.add_argument("--file", help="Read input from file")
167:     parser.add_argument("--output", choices=("text", "json"), default="text", help="Output format")
168:     args = parser.parse_args()
169: 
170:     if args.file:
171:         try:
172:             with open(args.file, "r", encoding="utf-8") as f:
173:                 text = f.read()
174:         except (IOError, OSError) as e:
175:             print(f"error: {e}", file=sys.stderr)
176:             return 1
177:     elif args.text:
178:         text = args.text
179:     else:
180:         text = SAMPLE_BAD
181: 
182:     result = analyze(text)
183:     if args.output == "json":
184:         print(json.dumps({"text": text, **result}, indent=2))
185:     else:
186:         print(render_text(text, result))
187:     return 0 if result["verdict"] == "CLEAN" else 1
188: 
189: 
190: if __name__ == "__main__":
191:     sys.exit(main())
