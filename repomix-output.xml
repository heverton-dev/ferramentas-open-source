<file path=".github/workflows/release.yml">
 1: name: Release
 2: 
 3: on:
 4:   push:
 5:     tags:
 6:       - "v*.*.*"
 7:   workflow_dispatch:
 8:     inputs:
 9:       tag:
10:         description: "Tag a publicar (ex.: v1.0.0)"
11:         required: true
12: 
13: permissions:
14:   contents: write
15: 
16: jobs:
17:   release:
18:     runs-on: ubuntu-latest
19:     steps:
20:       - uses: actions/checkout@v4
21:         with:
22:           fetch-depth: 0
23: 
24:       - uses: actions/setup-python@v5
25:         with:
26:           python-version: "3.11"
27: 
28:       # Nunca publicar release de um commit que nao passa na validacao:
29:       # um submodule quebrado se propaga para todos os projetos consumidores.
30:       - name: Validar antes de publicar
31:         run: |
32:           python tests/test-syntax.py
33:           bash tests/test-integration.sh
34: 
35:       - name: Criar release
36:         env:
37:           GH_TOKEN: ${{ github.token }}
38:           TAG: ${{ github.event.inputs.tag || github.ref_name }}
39:         run: |
40:           gh release create "$TAG" \
41:             --title "Fabrica Universal $TAG" \
42:             --generate-notes
</file>

