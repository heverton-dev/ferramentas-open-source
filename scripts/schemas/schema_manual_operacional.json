{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ManualOperacionalVPSUso",
  "type": "object",
  "required": [
    "produto_foco",
    "slug",
    "saas_origem",
    "versao",
    "licenca_osi",
    "vps_recomendada",
    "instalacao_producao",
    "manual_uso_exaustivo",
    "desinstalacao_cirurgica",
    "referencias_bibliograficas"
  ],
  "properties": {
    "produto_foco": { "type": "string" },
    "slug": { "type": "string" },
    "saas_origem": { "type": "string" },
    "versao": { "type": "string" },
    "licenca_osi": { "type": "string" },
    "tempo_estimado_setup": { "type": "string" },
    "nivelamento_conceitual": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["termo", "analogia_cotidiana", "explicacao_simples"],
        "properties": {
          "termo": { "type": "string" },
          "analogia_cotidiana": { "type": "string" },
          "explicacao_simples": { "type": "string" }
        }
      }
    },
    "vps_recomendada": {
      "type": "object",
      "required": ["provedor_modelo", "vcpu", "ram", "armazenamento", "so_recomendado", "custo_mensal_estimado", "portas_abertas"],
      "properties": {
        "provedor_modelo": { "type": "string" },
        "vcpu": { "type": "string" },
        "ram": { "type": "string" },
        "armazenamento": { "type": "string" },
        "so_recomendado": { "type": "string" },
        "custo_mensal_estimado": { "type": "string" },
        "portas_abertas": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "instalacao_producao": {
      "type": "object",
      "required": ["passos", "arquivos_configuracao"],
      "properties": {
        "passos": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["numero", "titulo", "descricao", "comandos", "fonte_id"],
            "properties": {
              "numero": { "type": "integer" },
              "titulo": { "type": "string" },
              "descricao": { "type": "string" },
              "analogia": { "type": "string" },
              "o_que_acontece_na_tela": { "type": "string" },
              "como_saber_se_deu_certo": { "type": "string" },
              "comandos": { "type": "string" },
              "fonte_id": { "type": "string" }
            }
          }
        },
        "arquivos_configuracao": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["caminho", "linguagem", "conteudo", "explicacao"],
            "properties": {
              "caminho": { "type": "string" },
              "linguagem": { "type": "string" },
              "conteudo": { "type": "string" },
              "explicacao": { "type": "string" }
            }
          }
        }
      }
    },
    "manual_uso_exaustivo": {
      "type": "object",
      "required": ["arquitetura_uso", "comandos_cli", "rotas_api", "interface_ui", "troubleshooting"],
      "properties": {
        "arquitetura_uso": { "type": "string" },
        "roteiro_primeiro_voo": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["passo", "acao", "resultado_esperado"],
            "properties": {
              "passo": { "type": "string" },
              "acao": { "type": "string" },
              "resultado_esperado": { "type": "string" }
            }
          }
        },
        "comandos_cli": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["comando", "descricao", "exemplo", "fonte_id"],
            "properties": {
              "comando": { "type": "string" },
              "descricao": { "type": "string" },
              "exemplo": { "type": "string" },
              "fonte_id": { "type": "string" }
            }
          }
        },
        "rotas_api": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["metodo", "rota", "descricao", "payload_exemplo", "fonte_id"],
            "properties": {
              "metodo": { "type": "string" },
              "rota": { "type": "string" },
              "descricao": { "type": "string" },
              "payload_exemplo": { "type": "string" },
              "fonte_id": { "type": "string" }
            }
          }
        },
        "interface_ui": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["modulo", "descricao", "recursos_chave"],
            "properties": {
              "modulo": { "type": "string" },
              "descricao": { "type": "string" },
              "recursos_chave": { "type": "array", "items": { "type": "string" } }
            }
          }
        },
        "troubleshooting": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["sintoma", "causa_provavel", "solucao_comando"],
            "properties": {
              "sintoma": { "type": "string" },
              "causa_provavel": { "type": "string" },
              "solucao_comando": { "type": "string" }
            }
          }
        }
      }
    },
    "desinstalacao_cirurgica": {
      "type": "object",
      "required": ["principio_isolamento", "passos", "checklist_saude_vps"],
      "properties": {
        "principio_isolamento": { "type": "string" },
        "passos": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["numero", "titulo", "descricao", "comandos", "alerta_seguranca"],
            "properties": {
              "numero": { "type": "integer" },
              "titulo": { "type": "string" },
              "descricao": { "type": "string" },
              "comandos": { "type": "string" },
              "alerta_seguranca": { "type": "string" },
              "como_validar": { "type": "string" }
            }
          }
        },
        "checklist_saude_vps": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "referencias_bibliograficas": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "categoria", "titulo", "url", "autor_ou_canal"],
        "properties": {
          "id": { "type": "string" },
          "categoria": { "type": "string" },
          "titulo": { "type": "string" },
          "url": { "type": "string" },
          "autor_ou_canal": { "type": "string" }
        }
      }
    }
  }
}
