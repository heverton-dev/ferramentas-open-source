{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TrilhaAprendizadoAutoguiado",
  "type": "object",
  "required": [
    "produto_foco",
    "slug",
    "saas_origem",
    "tempo_total_estimado",
    "fases"
  ],
  "properties": {
    "produto_foco": { "type": "string" },
    "slug": { "type": "string" },
    "saas_origem": { "type": "string" },
    "tempo_total_estimado": { "type": "string" },
    "fases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["fase_numero", "titulo", "tempo_estimado", "objetivo", "recursos"],
        "properties": {
          "fase_numero": { "type": "integer" },
          "titulo": { "type": "string" },
          "tempo_estimado": { "type": "string" },
          "objetivo": { "type": "string" },
          "recursos": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["titulo", "tipo_midia", "autor", "duracao", "url", "aprendizado_chave", "fonte_id"],
              "properties": {
                "titulo": { "type": "string" },
                "tipo_midia": { "type": "string" },
                "idioma": { "type": "string" },
                "dica_traducao_ptbr": { "type": "string" },
                "autor": { "type": "string" },
                "duracao": { "type": "string" },
                "url": { "type": "string", "format": "uri" },
                "aprendizado_chave": { "type": "string" },
                "fonte_id": { "type": "string" }
              }
            }
          }
        }
      }
    }
  }
}
