{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RelatorioDeSessao",
  "description": "Contrato estruturado para relatórios técnicos de encerramento de sessão de engenharia.",
  "type": "object",
  "properties": {
    "data": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "sessao_tema": { "type": "string", "minLength": 5 },
    "camadas_afetadas": {
      "type": "array",
      "items": { "type": "string", "enum": ["TELA", "HARNESS", "LLM", "TOOLS"] }
    },
    "bugs_corrigidos": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "causa": { "type": "string" },
          "correcao": { "type": "string" },
          "arquivo": { "type": "string" }
        },
        "required": ["causa", "correcao", "arquivo"]
      }
    },
    "arquivos_modificados": {
      "type": "array",
      "items": { "type": "string" }
    },
    "gates_executados": {
      "type": "array",
      "items": { "type": "string" }
    },
    "status_final": { "type": "string", "enum": ["SUCESSO", "PARCIAL", "FALHA"] }
  },
  "required": ["data", "sessao_tema", "camadas_afetadas", "arquivos_modificados", "status_final"],
  "additionalProperties": false
}
