{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SchemaDossieEcossistema",
  "description": "Schema canônico para validação de dossiês de macro-ecossistemas SaaS com análise por grupos e triangulação de ferramentas (Fluxo 4 AIDD)",
  "type": "object",
  "required": [
    "slug",
    "nome_ecossistema",
    "titulo",
    "subtitulo",
    "deck",
    "saas_substituido",
    "stats",
    "pilares",
    "camada_integracao",
    "deploy_consolidado",
    "analise_economica_global"
  ],
  "properties": {
    "slug": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "nome_ecossistema": { "type": "string", "minLength": 3 },
    "titulo": { "type": "string", "minLength": 5 },
    "subtitulo": { "type": "string", "minLength": 5 },
    "deck": { "type": "string", "minLength": 20 },
    "saas_substituido": { "type": "string" },
    "stats": {
      "type": "object",
      "required": ["total_pilares", "total_ferramentas", "licencas_osi", "economia_media", "autonomia"],
      "properties": {
        "total_pilares": { "type": "integer", "minimum": 2 },
        "total_ferramentas": { "type": "integer", "minimum": 4 },
        "licencas_osi": { "type": "string" },
        "economia_media": { "type": "string" },
        "autonomia": { "type": "string" }
      }
    },
    "pilares": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": [
          "pilar_id",
          "nome_pilar",
          "modulo_saas_alvo",
          "descricao_pilar",
          "subtotal_economia_anual",
          "ferramentas"
        ],
        "properties": {
          "pilar_id": { "type": "string" },
          "nome_pilar": { "type": "string" },
          "modulo_saas_alvo": { "type": "string" },
          "descricao_pilar": { "type": "string" },
          "subtotal_economia_anual": { "type": "string" },
          "ferramentas": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "object",
              "required": [
                "rank",
                "slug",
                "nome",
                "subtitulo",
                "papel_no_pilar",
                "saas_substituido_direto",
                "racional_escolha",
                "economia_anual_str",
                "licenca_osi",
                "repositorio_github",
                "o_que_faz",
                "como_funciona",
                "comando_rapido",
                "requisitos_infra"
              ]
            }
          }
        }
      }
    },
    "camada_integracao": {
      "type": "object",
      "required": [
        "autenticacao_sso",
        "barramento_eventos",
        "gateway_reverse_proxy",
        "fluxo_integracao_descricao"
      ]
    },
    "deploy_consolidado": {
      "type": "object",
      "required": [
        "docker_compose_exemplo",
        "requisitos_hardware_totais",
        "passos_deploy"
      ]
    },
    "analise_economica_global": {
      "type": "object",
      "required": ["custo_saas_anual", "custo_vps_anual", "economia_anual_liquida", "roi_meses"],
      "properties": {
        "custo_saas_anual": { "type": "string" },
        "custo_vps_anual": { "type": "string" },
        "economia_anual_liquida": { "type": "string" },
        "roi_meses": { "type": "string" },
        "detalhamento_por_grupo": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["grupo", "saas_referencia", "custo_saas_anual", "custo_vps_alocado", "economia_anual_liquida", "percentual_economia"],
            "properties": {
              "grupo": { "type": "string" },
              "saas_referencia": { "type": "string" },
              "custo_saas_anual": { "type": "string" },
              "custo_vps_alocado": { "type": "string" },
              "economia_anual_liquida": { "type": "string" },
              "percentual_economia": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
