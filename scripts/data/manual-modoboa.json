        "titulo": "Clonar Repositório Modoboa",
        "descricao": "Download código-fonte do GitHub",
        "analogia": "Trazer plantas construção",
        "o_que_acontece_na_tela": "Git exibe Cloning into",
        "como_saber_se_deu_certo": "/opt/modoboa existe",
        "comandos": "cd /opt && git clone https://github.com/modoboa/modoboa.git\ncd modoboa && git checkout v2.3.0",
        "fonte_id": "F01"
      },
      {
        "numero": 4,
        "titulo": "Instalador Automático",
        "descricao": "Configura PostgreSQL, Postfix, Dovecot, Nginx, Django",
        "analogia": "Apertar botão construir",
        "o_que_acontece_na_tela": "Perguntas hostname/domínio/senha",
        "como_saber_se_deu_certo": "Installation complete!",
        "comandos": "cd /opt/modoboa\npython3 -m pip install -U pip setuptools wheel\npython3 -m pip install -e .\nmodoboa deploy /var/vmail/modoboa",
        "fonte_id": "F03"
      },
      {
        "numero": 5,
        "titulo": "Configurar Firewall UFW",
        "descricao": "Liberar portas 22,25,80,143,110,587,443",
        "analogia": "Guarita porteiro",
        "o_que_acontece_na_tela": "Rule added para cada porta",
        "como_saber_se_deu_certo": "ufw status OK",
        "comandos": "ufw default deny incoming && ufw default allow outgoing\nufw allow 22/tcp && ufw allow 25/tcp && ufw allow 80/tcp && ufw allow 143/tcp && ufw allow 110/tcp && ufw allow 587/tcp && ufw allow 443/tcp\nufw --force enable",
        "fonte_id": "F05"
      },
      {
        "numero": 6,
        "titulo": "Ativar HTTPS Let's Encrypt",
        "descricao": "Certificado SSL/TLS que renova automaticamente",
