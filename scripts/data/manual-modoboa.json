      "143/tcp (IMAP - Acesso clientes de email)",
      "110/tcp (POP3 - Acesso legado)",
      "587/tcp (Submission - Envio seguro autenticado)",
      "80/tcp (HTTP - Let's Encrypt renewal)",
      "443/tcp (HTTPS - Admin e webmail)"
    ]
  },
