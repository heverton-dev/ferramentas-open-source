  "desinstalacao_cirurgica": {
    "principio_isolamento": "Remove exclusivamente instância Modoboa (Django, dados email, bancos SQL). Preserva Postfix, Dovecot, certificados SSL e SO.",
    "passos": [
      {
        "numero": 1,
        "titulo": "Parada de Serviços Modoboa",
        "descricao": "Para Django (Gunicorn) e Celery sem afetar Postfix/Dovecot/Nginx",
        "comandos": "sudo systemctl stop modoboa\nsudo systemctl disable modoboa\nsudo systemctl stop modoboa-celery\nsudo systemctl disable modoboa-celery",
        "alerta_seguranca": "NÃO execute 'systemctl stop postfix' ou 'systemctl stop dovecot'",
        "como_validar": "sudo systemctl is-active modoboa # Retorna 'inactive'"
      },
      {
        "numero": 2,
        "titulo": "Remoção do Banco PostgreSQL",
        "descricao": "Deleta schema Modoboa, preservando outros bancos",
        "comandos": "sudo -u postgres psql -c \"DROP DATABASE IF EXISTS modoboa;\"\nsudo -u postgres psql -c \"DROP USER IF EXISTS modoboa;\"",
        "alerta_seguranca": "JAMAIS execute 'DROP DATABASE postgres;'",
        "como_validar": "sudo -u postgres psql -l | grep modoboa # Não deve aparecer"
      },
      {
        "numero": 3,
        "titulo": "Remoção de Diretórios",
        "descricao": "Remove /var/vmail/modoboa (dados) e /opt/modoboa (código)",
        "comandos": "sudo rm -rf /var/vmail/modoboa\nsudo rm -rf /opt/modoboa\nsudo rm -f /etc/systemd/system/modoboa.service\nsudo rm -f /etc/systemd/system/modoboa-celery.service",
        "alerta_seguranca": "Não execute 'rm -rf /' nem 'rm -rf /var/'",
        "como_validar": "ls -ld /var/vmail/modoboa 2>&1 | grep 'cannot access'"
      },
      {
        "numero": 4,
        "titulo": "Limpeza Nginx",
        "descricao": "Remove virtual host Modoboa do Nginx",
        "comandos": "sudo rm -f /etc/nginx/sites-enabled/modoboa\nsudo rm -f /etc/nginx/sites-available/modoboa\nsudo systemctl reload nginx\nsudo systemctl daemon-reload",
        "alerta_seguranca": "Mantenha outros sites em /etc/nginx/sites-available/",
        "como_validar": "sudo nginx -t # Retorna 'configuration OK'"
      }
    ],
    "checklist_saude_vps": [
      "ps aux | grep -E '(gunicorn|celery|modoboa)' # Nenhum processo deve aparecer",
      "sudo -u postgres psql -l # Banco 'modoboa' não deve estar na lista",
      "sudo systemctl status postfix # Deve estar 'active'",
      "sudo systemctl status dovecot # Deve estar 'active'",
      "sudo systemctl status nginx # Deve estar 'active'",
      "free -h # RAM devolvida ao sistema"
    ]
  }
