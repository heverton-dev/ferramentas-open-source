        "como_saber_se_deu_certo": "Cadeado verde https://seu-ip",
        "comandos": "apt-get install -y certbot python3-certbot-nginx\ncertbot certonly --nginx -d seu-dominio.com\nsudo systemctl restart nginx",
        "fonte_id": "F04"
      }
    ],
    "arquivos_configuracao": [
      {
        "caminho": "/etc/postfix/main.cf",
        "linguagem": "conf",
        "conteudo": "myhostname = mail.seu-dominio.com\nmydomain = seu-dominio.com\nvirtual_mailbox_base = /var/vmail\nvirtual_uid_maps = static:901",
        "explicacao": "Integração Postfix com PostgreSQL"
      },
      {
        "caminho": "/etc/dovecot/conf.d/10-mail.conf",
        "linguagem": "conf",
        "conteudo": "mail_location = maildir:~/.maildir:LAYOUT=fs\nprotocols = imap pop3\nlisten = *, ::",
        "explicacao": "Armazenamento maildir IMAP/POP3"
      },
      {
        "caminho": "/etc/nginx/sites-available/modoboa",
        "linguagem": "nginx",
        "conteudo": "upstream modoboa { server 127.0.0.1:8000; }\nserver { listen 80; server_name admin.seu-dominio.com; location / { proxy_pass http://modoboa; } }",
        "explicacao": "Proxy reverso Nginx para Django"
      }
    ]
  },
