        "descricao": "Clone e compilação em C/C++ puro com instruções vetoriais AVX2.",
        "comandos": "apt-get update && apt-get install -y build-essential git\nmkdir -p /opt/whisper-cpp && cd /opt/whisper-cpp\ngit clone https://github.com/ggerganov/whisper.cpp .\nmake -j4",
