        "fonte_id": "F02"
      },
      {
        "numero": 3,
        "titulo": "Execução da Transcrição Ultrarrápida",
        "descricao": "Transcrição de áudio em segundos consumindo menos de 200 MB de RAM.",
        "comandos": "./main -m models/ggml-base.bin -f reuniao.wav -l pt -otxt",
        "fonte_id": "F04"
      }
    ],
    "arquivos_configuracao": [
      {
        "caminho": "/opt/whisper-cpp/run_transcribe.sh",
        "linguagem": "bash",
        "conteudo": "#!/usr/bin/env bash\n/opt/whisper-cpp/main -m /opt/whisper-cpp/models/ggml-base.bin -f \"$1\" -l pt -otxt",
