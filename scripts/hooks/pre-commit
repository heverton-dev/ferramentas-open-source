#!/bin/sh
# Hook pre-commit UNIVERSAL & AUTO-CURATIVO — mecaniza R5, R15, R16 e R18.
#
# Fonte versionada: scripts/hooks/pre-commit
# Copiado para .git/hooks/pre-commit por scripts/setup-links.ps1|.sh
#
# Executa auto-cura de compêndios e sincronização de espelhos silenciosamente antes de auditar.

# === AUTO-CURA MECÂNICA & HIGIENIZAÇÃO (R5 & R18) ==========================
if [ -f scripts/limpar_entulho.py ] && command -v python >/dev/null 2>&1; then
    python scripts/limpar_entulho.py >/dev/null 2>&1
    git add output/ docs/ >/dev/null 2>&1 || true
fi

# === GATE 1: SEGREDOS (R15) — sempre ativo ==================================
DIFF_STAGED=$(git diff --cached)

for padrao in \
    'sk-[a-zA-Z0-9_-]{20,}' \
    'AKIA[0-9A-Z]{16}' \
    '-----BEGIN [A-Z ]*PRIVATE KEY' \
    'gh[pousr]_[a-zA-Z0-9]{36}' \
    'github_pat_[a-zA-Z0-9_]{22,}' \
    'xox[baprs]-[0-9a-zA-Z-]+' \
    'AIza[0-9A-Za-z_-]{35}'
do
    if printf '%s' "$DIFF_STAGED" | grep -Eq -- "$padrao"; then
        echo "[BLOQUEADO] possivel segredo no diff staged"
        echo ""
        echo "Padrao detectado: $padrao"
        printf '%s' "$DIFF_STAGED" | grep -n -E -- "$padrao" | head -5
        echo ""
        echo "Se e falso positivo, revise manualmente ou use 'git commit --no-verify' (com cuidado)."
        exit 1
    fi
done

# === GATE 2: TESTES PYTHON (R16) — so se houver pytest e testes ==============
if [ -d tests ] || [ -f pytest.ini ] || [ -f pyproject.toml ]; then
    if command -v python >/dev/null 2>&1 && python -c "import pytest" >/dev/null 2>&1; then
        if ls tests/test_*.py test_*.py >/dev/null 2>&1; then
            python -m pytest -q
            if [ $? -ne 0 ]; then
                echo "[BLOQUEADO] suite de testes vermelha - corrija a causa antes de comitar (R16)"
                exit 1
            fi
        fi
    fi
fi

# === GATE 3: TESTES NODE (R16) — so se houver script "test" no package.json ==
if [ -f package.json ] && command -v npm >/dev/null 2>&1; then
    if grep -q '"test"[[:space:]]*:' package.json; then
        npm test --silent
        if [ $? -ne 0 ]; then
            echo "[BLOQUEADO] suite de testes vermelha - corrija a causa antes de comitar (R16)"
            exit 1
        fi
    fi
fi

# === GATE 4: SINTAXE PYTHON dos arquivos staged =============================
ARQS_PY=$(git diff --cached --name-only --diff-filter=ACM | grep '\.py$' || true)
if [ -n "$ARQS_PY" ] && command -v python >/dev/null 2>&1; then
    for f in $ARQS_PY; do
        [ -f "$f" ] || continue
        python -m py_compile "$f" || {
            echo "[BLOQUEADO] erro de sintaxe Python em: $f"
            exit 1
        }
    done
fi

# === GATE 5: CONFORMIDADE DO PADRÃO DOSSIÊ EXECUTIVO DIAMANTE (R5) ==========
if [ -f scripts/auditar_r5_dossie.py ] && command -v python >/dev/null 2>&1; then
    python scripts/auditar_r5_dossie.py >/dev/null 2>&1
    if [ $? -ne 0 ]; then
        echo "[BLOQUEADO] Compêndios fora do Padrão Diamante R5 detectados."
        exit 1
    fi
fi

# === GATE 5.5: CONFORMIDADE DOSSIÊ VERTICAL SAAS (R5-V) =====================
if [ -f scripts/auditar_tipo_vertical.py ] && command -v python >/dev/null 2>&1; then
    python scripts/auditar_tipo_vertical.py >/dev/null 2>&1
    if [ $? -ne 0 ]; then
        echo "[BLOQUEADO] Dossiês Verticais fora da Regra R5-V detectados."
        exit 1
    fi
fi

# === GATE 6: HIGIENE CONTÍNUA, ZERO ENTULHO & PARIDADE DE ESPELHOS (R18) ====
if [ -f scripts/auditar_higiene_repo.py ] && command -v python >/dev/null 2>&1; then
    python scripts/auditar_higiene_repo.py >/dev/null 2>&1
    if [ $? -ne 0 ]; then
        echo "[BLOQUEADO] Violação da Regra R18 detectada."
        exit 1
    fi
fi


# >>> gate-de-segredos
python "$(git rev-parse --show-toplevel)/scripts/verificar_segredos.py" || exit 1
# <<< gate-de-segredos

exit 0
